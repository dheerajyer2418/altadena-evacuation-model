# Real data and run artifacts are NOT version-controlled.
data/raw/
data/interim/
data/processed/
outputs/
*.graphml
*.gpkg

# INRIX data & credentials MUST stay out of version control.
inrix/
*.inrix
.env
*census_api_key*
secrets.*

# Survey microdata (human subjects) MUST stay out of version control.
*.docx
*.xlsx
*[Ss]urvey*

# stray local output dirs (note: canonical results dir is outputs/, plural)
output/
tmp/

# osmnx HTTP cache
cache/

# generated standalone UI bundle (large; regenerate with export_standalone)
altadena_live.html

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Keep fixtures (synthetic, safe to commit) and config.
!fixtures/
!config/
